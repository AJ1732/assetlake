# Tooling secrets (seed, live test lane) are read from the repo-root .env.local.
# demo-web (Next) reads apps/demo-web/.env.local; wired in B03.

# demo-web (server only, never NEXT_PUBLIC_) and `pnpm seed`. The project id is public; blank or
# unset means the demo's (oshzwvjy). demo-web hands it to /live as a prop, not a NEXT_PUBLIC_ twin.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-04
SANITY_WRITE_TOKEN=
ASSETLAKE_DEMO_PASSCODE=
ASSETLAKE_SESSION_SECRET=
ASSETLAKE_DAILY_UPLOAD_CAP=200

# live test lane
SANITY_TEST_DATASET=test

# The console and the schema package read their own prefixed variables from their own .env files
# (apps/asset-console/.env, packages/sanity-schema/.env); see their READMEs. Unset means the demo's.
# SANITY_APP_PROJECT_ID=
# SANITY_APP_DATASET=production
# ASSETLAKE_CONSOLE_ORGANIZATION_ID=
# ASSETLAKE_CONSOLE_APP_ID=
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production

# @assetlake/cli reads its own variables (bring-your-own project). Nothing in this repo needs them;
# the CLI live test maps SANITY_WRITE_TOKEN onto ASSETLAKE_TOKEN itself.
# ASSETLAKE_TOKEN=
# ASSETLAKE_PROJECT_ID=
# ASSETLAKE_DATASET=production
