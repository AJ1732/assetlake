# Server only: no NEXT_PUBLIC_ prefix, so Next never ships these to the browser.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=
# The application id `npx @assetlake/cli init` prints.
ASSETLAKE_APPLICATION_ID=assetlake-application-my-app
# Hosts uploadFromUrl may fetch from, comma separated (empty turns it off).
ASSETLAKE_REMOTE_HOSTS=
# Stand-in for your auth: requests act as this user. Unset, every upload gets 401.
EXAMPLE_LOCAL_USER=
