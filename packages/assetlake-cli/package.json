{
  "name": "@assetlake/cli",
  "version": "0.1.0",
  "description": "Set up, upload to and check AssetLake in your own Sanity project from the terminal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJ1732/sal.git",
    "directory": "packages/assetlake-cli"
