{
  "name": "@assetlake/sanity-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./project": "./src/project.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema:deploy": "sanity schemas deploy",
    "schema:list": "sanity schemas list",
    "typegen": "sanity schemas extract --force --enforce-required-fields && sanity typegen generate"
  },
  "dependencies": {
    "@assetlake/core": "workspace:*",
    "@sanity/icons": "^5.2.3",
    "@sanity/types": "^6.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.17.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
